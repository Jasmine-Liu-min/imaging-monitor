# 模板：复制为 .env 后填写（cp .env.example .env）。.env 已被 git 忽略，勿提交明文密钥。
# 留空 AI key 时，流水线会自动降级为规则抽取，不会中断。
#
# 推荐思路：
# 1. 优先用 OpenAI-compatible 接口（DeepSeek / OpenAI / 通义 / OpenRouter / 硅基流动 / Kimi / 企业网关）
# 2. 只有在你明确要走 Claude 原生 Messages API 时，才切到 AI_PROVIDER=anthropic

# ===== 默认：DeepSeek（推荐）=====
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_WIRE_API=chat
AI_API_KEY=                # 你的 DeepSeek key（sk-...）

# ===== OpenAI =====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_WIRE_API=chat
# AI_API_KEY=sk-...

# ===== 通义千问（DashScope 兼容模式）=====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
# AI_WIRE_API=chat
# AI_API_KEY=sk-...

# ===== OpenRouter =====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4.1-mini
# AI_WIRE_API=chat
# AI_API_KEY=sk-or-...

# ===== Moonshot / Kimi =====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-8k
# AI_WIRE_API=chat
# AI_API_KEY=sk-...

# ===== 硅基流动 =====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Qwen/Qwen2.5-72B-Instruct
# AI_WIRE_API=chat
# AI_API_KEY=sk-...

# ===== 企业/自建 OpenAI-compatible 网关 =====
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-gateway.example.com
# AI_MODEL=gpt-4.1-mini
# AI_WIRE_API=chat          # 若网关支持 Responses API，可改成 responses
# AI_API_KEY=token-...

# ===== Claude 公网 / Anthropic 原生协议 =====
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Claude 企业网关（Anthropic 协议 + Bearer）=====
# AI_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_AUTH_TOKEN=token-...

# ----- 运行参数 -----
AI_MAX_TOKENS=8000         # 单次输出上限；配合分片足够，无需太大
AI_TIMEOUT_SECONDS=120     # 单次 AI 请求超时
AI_RETRY_ATTEMPTS=3        # 网络错误/坏 JSON 的重试次数
AI_CHUNK_SIZE=6            # 每片送入 AI 的候选数（小批=输出短、更稳）
AI_MAX_PARALLEL=2          # 分片并发数（默认保守，优先兼容不稳定网关）
AI_TEMPERATURE=            # 可选；OpenAI-compatible 常用 0~0.3，Claude 新模型建议留空
AI_RESPONSES_JSON_FORMAT=  # 可选；responses 接口想强制 json_object 时填 true
AI_MONITOR_REASONING_EFFORT= # 可选；responses 接口可填 low/medium/high

# ----- 飞书推送 / 看板 -----
FEISHU_WEBHOOK_URL=        # 飞书群机器人 webhook；留空则只生成数据不推送
PUBLIC_DASHBOARD_URL=      # 推送卡片里的“打开看板”链接
